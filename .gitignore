# OS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Local scratch / work-in-progress
.development/

# Pester / test output (NUnit XML embeds machine name + username)
testResults.xml
*.test.xml
coverage.xml
TestResults/
test-results/

# Smart-deployment state - per-environment, regenerated each pipeline run.
# Deploy-iSOCContent writes deployment-state.json (no leading dot).
deployment-state.json

# Blog drafts (kept locally)
Blog
Blog/*

# Local-only scripts not yet ready for the repo
Tools/Test-DefenderSentinelParity.ps1
Tools/GUIDE-DefenderSentinelParity.md

# iSOC Blueprint output: contains tenant configuration; never commit.
# Delivered via the workflow's private GitHub Actions artefact instead.
# BlueprintRuns/ and any <folder>/<workspace>/_raw/ cover output written
# with -OutputPath; the test fixtures' _raw folders stay tracked.
# .githooks/pre-push refuses a GitHub push that carries any of it.
SecurityDocs/
BlueprintRuns/
_raw/
!Tests/**/Fixtures/**/_raw/
.sentinel-connectors.json
Demo

# Export-iSOCTableMigrationReport writes its report bundle (html/json/csv)
# to a migration-report/ folder in the working directory by default.
migration-report/

# Invoke-iSOCClassicTableMigration and New-iSOCDcrFromSchema write their
# templates (dcr-<table>.json, table-<table>.json) to the current folder
# unless -Path or -OutputDirectory says otherwise, so a run from the
# repository root leaves them here. Transient artefacts; the ones you want
# tracked go to Infra/dcr. Anchored to the root so Infra/dcr is untouched.
/dcr-*.json
/table-*.json

# Local secrets for live DCR ingestion testing (Test-iSOCDcrIngestion reads
# .env from the current folder, or the file -EnvFile names). Never commit
# the real .env (service-principal client secrets); the template is
# committed as Modules/iSOCDeployments/Resources/ClassicToDcr/.env.example.
.env
.env.*
!.env.example
