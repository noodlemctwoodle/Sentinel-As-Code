# OS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Local scratch / work-in-progress
.development/

# Pester / test output (NUnit XML embeds machine name + username)
testResults.xml
*.test.xml
coverage.xml
TestResults/
test-results/

# Smart-deployment state — per-environment, regenerated each pipeline run
.deployment-state.json

# Blog drafts (kept locally)
Blog
Blog/*

# Local-only scripts not yet ready for the repo
Tools/Test-DefenderSentinelParity.ps1
Tools/GUIDE-DefenderSentinelParity.md
Tools/Export-Playbooks.ps1

# Sentinel documenter output — contains tenant configuration; never commit.
# Delivered via the workflow's private GitHub Actions artefact instead.
SecurityDocs/

# Generated DCR templates land here when the migration tool runs from its
# own folder (its default output is the working directory). Transient
# artefacts; the ones you want tracked go to Infra/dcr via -OutputDirectory.
Tools/ClassicToDcr/dcr-*.json

# Local secrets for live DCR ingestion testing (Test-DcrIngestion.ps1).
# Never commit the real .env (service-principal client secrets); the
# .env.example template is committed so adopters know what to fill in.
.env
.env.*
!.env.example
