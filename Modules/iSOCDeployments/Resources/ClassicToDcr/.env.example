# Service principal used by Test-iSOCDcrIngestion to stream into the DCR's Logs
# Ingestion endpoint. Copy this file to `.env` in the folder you run the command
# from (the real `.env` is gitignored), and fill in the values.
# Test-iSOCDcrIngestion reads `.env` from the current folder only; to keep the
# file somewhere else, pass its path with -EnvFile. Values already set in the
# environment are never overwritten by the file.
#
# The service principal needs only one Azure role:
#   Monitoring Metrics Publisher, scoped to the target DCR.

DCR_INGEST_TENANT_ID=
DCR_INGEST_CLIENT_ID=
DCR_INGEST_CLIENT_SECRET=
