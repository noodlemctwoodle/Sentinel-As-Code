<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sentinel Table Migration Review</title>
<style>
  :root {
    --bg: #0a0f1e;
    --bg-subtle: #0f1629;
    --panel: #141b2d;
    --panel-hover: #1a2340;
    --card: #111827;
    --border: #1e293b;
    --border-hover: #334155;
    --text: #f1f5f9;
    --text-secondary: #cbd5e1;
    --muted: #64748b;
    --accent: #3b82f6;
    --accent-dim: rgba(59, 130, 246, 0.12);
    --cyan: #06b6d4;
    --cyan-dim: rgba(6, 182, 212, 0.12);
    --ok: #10b981;
    --ok-dim: rgba(16, 185, 129, 0.12);
    --warn: #f59e0b;
    --warn-dim: rgba(245, 158, 11, 0.12);
    --err: #ef4444;
    --err-dim: rgba(239, 68, 68, 0.12);
    --purple: #8b5cf6;
    --purple-dim: rgba(139, 92, 246, 0.12);
    --code-bg: #0b1120;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-xs: 6px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Header ── */
  .header {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #1e3a8a 100%);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 48px;
    position: relative;
  }
  .header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .header h1 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
  }
  .header .subtitle {
    color: var(--muted);
    font-size: 14px;
    max-width: 600px;
  }
  .version-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid rgba(59, 130, 246, 0.3);
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--radius-xs);
    font-size: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  .meta-chip .meta-label {
    color: var(--muted);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.5px;
  }

  /* ── Layout ── */
  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 48px 64px;
  }

  /* ── Stats grid ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }
  .stat {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.15s;
  }
  .stat:hover {
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }
  .stat .icon-bg {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    opacity: 0.5;
  }
  .stat .label {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .stat .value {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
  }
  .stat .desc {
    font-size: 11px;
    color: var(--muted);
    margin-top: 6px;
  }

  /* ── Section headers ── */
  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 40px 0 16px;
  }
  .section-header .section-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .section-header h2 {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: var(--text);
    text-transform: none;
    margin: 0;
  }
  .section-header .section-count {
    font-size: 12px;
    color: var(--muted);
    font-weight: 500;
  }

  /* ── Filter bar ── */
  .filter-bar {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    padding: 4px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: fit-content;
  }
  .filter-btn {
    background: transparent;
    border: none;
    color: var(--muted);
    padding: 7px 16px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 12px;
    font-family: inherit;
    font-weight: 500;
    transition: all 0.15s;
  }
  .filter-btn:hover { color: var(--text); background: rgba(255,255,255,0.05); }
  .filter-btn.active {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
  }

  /* ── Table cards ── */
  .table-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 12px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .table-card:hover { border-color: var(--border-hover); }
  .table-card[open] {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.15), 0 4px 24px rgba(0, 0, 0, 0.3);
  }
  .table-card > summary {
    padding: 18px 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 14px;
    user-select: none;
    list-style: none;
    transition: background 0.15s;
  }
  .table-card > summary:hover { background: var(--panel-hover); }
  .table-card > summary::-webkit-details-marker { display: none; }
  .table-card > summary .chevron {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: rgba(255,255,255,0.04);
    transition: transform 0.2s, background 0.15s;
    flex-shrink: 0;
    color: var(--muted);
    font-size: 10px;
  }
  .table-card[open] > summary .chevron { transform: rotate(90deg); background: var(--accent-dim); color: var(--accent); }
  .table-name {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 14px;
    font-weight: 600;
    flex: 1;
    letter-spacing: -0.2px;
  }
  .badge-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }

  /* ── Badges ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge.impacted { background: var(--err-dim); color: var(--err); }
  .badge.clean { background: var(--ok-dim); color: var(--ok); }
  .badge.warn { background: var(--warn-dim); color: var(--warn); }
  .badge.info { background: var(--accent-dim); color: var(--accent); }
  .badge.platform { background: var(--cyan-dim); color: var(--cyan); }
  .badge.ccf { background: var(--ok-dim); color: var(--ok); }
  .badge.purple { background: var(--purple-dim); color: var(--purple); }
  /* Chained (via-parser) dependency. Cyan ties it to the Parsers rows in the
     same card, which dotColor() already paints cyan.

     The chain is the whole point of an indirect row: it is the answer to "why
     does this break?". Truncating it to an ellipsis hides exactly the parser an
     operator has to go and look at, and a title tooltip does not help when
     scanning or printing. So it wraps instead of clipping, and the arrows are
     given wrap opportunities so a long chain breaks between hops rather than
     mid-name. */
  .badge.via {
    background: var(--cyan-dim);
    color: var(--cyan);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-weight: 500;
    display: inline-block;
    white-space: normal;
    overflow-wrap: break-word;
    text-align: left;
    line-height: 1.5;
  }

  /* ── Detail body ── */
  .detail-body { border-top: 1px solid var(--border); }
  .detail-section { padding: 20px 24px; border-bottom: 1px solid var(--border); }
  .detail-section:last-child { border-bottom: none; }
  .detail-section h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .detail-section h3 .count {
    background: rgba(255,255,255,0.06);
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 10px;
    color: var(--text-secondary);
  }

  /* ── Item lists ── */
  .item-list { display: flex; flex-direction: column; gap: 4px; }
  .item {
    display: flex;
    align-items: center;
    /* A long parser chain gets its own line rather than squeezing the name or
       spilling out of the card. Short chains still sit inline. */
    flex-wrap: wrap;
    row-gap: 6px;
    gap: 10px;
    padding: 10px 14px;
    background: var(--code-bg);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
    font-size: 13px;
    transition: border-color 0.15s;
  }
  .item:hover { border-color: var(--border); }
  .item .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  /* Indirect rows: hollow dot and a cyan left edge. padding-left compensates
     the pixel the thicker border takes, so both kinds stay optically aligned. */
  .item .dot.indirect { background: transparent; }
  .item.indirect {
    border-left-width: 2px;
    border-left-color: rgba(6, 182, 212, 0.45);
    padding-left: 13px;
  }
  .detail-section h3 .count-split {
    background: none;
    padding: 0;
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }
  .callout .callout-text code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    color: var(--text);
  }
  .item .item-name { flex: 1; font-weight: 500; }
  .item .item-meta {
    color: var(--muted);
    font-size: 10px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  .item .severity {
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .severity.high { background: var(--err-dim); color: var(--err); }
  .severity.medium { background: var(--warn-dim); color: var(--warn); }
  .severity.low { background: var(--cyan-dim); color: var(--cyan); }
  .severity.informational { background: rgba(255,255,255,0.06); color: var(--muted); }

  .solution-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--code-bg);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
    font-size: 13px;
  }
  .solution-item .sol-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 14px;
  }
  .solution-item .sol-details { flex: 1; }
  .solution-item .sol-name { font-weight: 600; font-size: 13px; }
  .solution-item .sol-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .solution-item .sol-actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }

  /* ── Empty state ── */
  .empty-state {
    color: var(--muted);
    font-size: 13px;
    font-style: italic;
    padding: 16px 0;
  }

  /* ── Callout boxes ── */
  .callout {
    border-radius: var(--radius-sm);
    padding: 16px 20px;
    margin-top: 4px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .callout .callout-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 16px;
  }
  .callout .callout-body { flex: 1; }
  .callout .callout-title { font-weight: 700; font-size: 13px; margin-bottom: 4px; }
  .callout .callout-text { font-size: 12px; line-height: 1.6; }

  .callout.action-required {
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
  .callout.action-required .callout-icon { background: var(--err-dim); color: var(--err); }
  .callout.action-required .callout-title { color: var(--err); }
  .callout.action-required .callout-text { color: var(--text-secondary); }

  .callout.attention {
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.2);
  }
  .callout.attention .callout-icon { background: var(--warn-dim); color: var(--warn); }
  .callout.attention .callout-title { color: var(--warn); }
  .callout.attention .callout-text { color: var(--text-secondary); }

  .callout.success {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }
  .callout.success .callout-icon { background: var(--ok-dim); color: var(--ok); }
  .callout.success .callout-title { color: var(--ok); }
  .callout.success .callout-text { color: var(--text-secondary); }

  /* Severed-chain lists. A skipped alias is a KNOWN gap in the dependency
     list, so it needs to read as an inventory of work, not a footnote. */
  .callout .bridge-list { margin: 8px 0 0 0; padding-left: 18px; }
  .callout .bridge-list > li { margin-bottom: 8px; line-height: 1.6; }
  .callout .bridge-list ul { margin: 4px 0 0 0; padding-left: 16px; }
  .callout .bridge-list ul li { margin-bottom: 2px; }
  .callout .bridge-type {
    display: inline-block; font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--text-tertiary, var(--text-secondary)); margin-right: 6px;
  }
  .callout .bridge-none { margin-top: 4px; font-style: italic; opacity: 0.8; }

  .callout.info {
    background: rgba(59, 130, 246, 0.06);
    border: 1px solid rgba(59, 130, 246, 0.2);
  }
  .callout.info .callout-icon { background: var(--accent-dim); color: var(--accent); }
  .callout.info .callout-title { color: var(--accent); }
  .callout.info .callout-text { color: var(--text-secondary); }

  /* ── About section ── */
  .about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .about-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    transition: border-color 0.2s;
  }
  .about-card:hover { border-color: var(--border-hover); }
  .about-card h3 { font-size: 14px; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .about-card p { font-size: 13px; color: var(--text-secondary); line-height: 1.7; }
  .about-card .doc-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .about-card .doc-link:hover { text-decoration: underline; }

  .contributor {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .contributor.primary { border-color: rgba(59, 130, 246, 0.3); }
  .contributor .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    flex-shrink: 0;
  }
  .contributor .contrib-info { flex: 1; }
  .contributor .contrib-name { font-weight: 700; font-size: 14px; }
  .contributor .contrib-roles { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }
  .contributor .role-tag {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .role-tag.developer { background: var(--accent-dim); color: var(--accent); }
  .role-tag.designer { background: var(--purple-dim); color: var(--purple); }
  .role-tag.tester { background: var(--ok-dim); color: var(--ok); }
  .contributor .contrib-desc { font-size: 11px; color: var(--muted); margin-top: 6px; }
  .contributor .contrib-links { display: flex; gap: 6px; flex-shrink: 0; }
  .contrib-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    color: var(--muted);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    font-size: 12px;
  }
  .contrib-link:hover { background: rgba(255,255,255,0.06); color: var(--text); }

  /* ── Links ── */
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  /* ── Footer ── */
  footer {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px 48px 40px;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
    border-top: 1px solid var(--border);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .header-inner, main, footer { padding-left: 20px; padding-right: 20px; }
    .header-top { flex-direction: column; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .about-grid { grid-template-columns: 1fr; }
    .cmd-block { flex-direction: column; }
    .cmd-copy { align-self: flex-start; }
  }

  /* ── SVG icons ── */
  .icon { width: 14px; height: 14px; display: inline-block; vertical-align: middle; }
  .icon-sm { width: 12px; height: 12px; }
  .icon-lg { width: 18px; height: 18px; }

  /* ── About button (header) ── */
  .about-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .about-btn:hover { background: rgba(255,255,255,0.1); color: var(--text); border-color: rgba(255,255,255,0.2); }

  /* ── Modal overlay ── */
  body.modal-open { overflow: hidden; }
  .modal-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: 24px;
    overflow-y: auto;
  }
  .modal-backdrop.open { display: flex; }
  .modal {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 16px;
    width: 100%;
    max-width: 960px;
    margin: auto;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.05);
    animation: modalIn 0.2s ease-out;
    position: relative;
  }
  @keyframes modalIn {
    from { opacity: 0; transform: translateY(-12px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px 0;
  }
  .modal-header h2 {
    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--text);
    text-transform: none;
  }
  .modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: none;
    background: rgba(255,255,255,0.06);
    color: var(--muted);
    cursor: pointer;
    font-size: 16px;
    transition: all 0.15s;
  }
  .modal-close:hover { background: rgba(255,255,255,0.1); color: var(--text); }
  .modal-body { padding: 24px 28px 28px; }
  .modal-section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    font-weight: 600;
    margin: 24px 0 12px;
  }
  .modal-section-label:first-child { margin-top: 0; }
  .modal-app-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 4px;
  }
  .modal-app-info .app-name { font-weight: 700; font-size: 14px; }
  .modal-app-info .app-desc { font-size: 12px; color: var(--muted); margin-top: 2px; }

  /* ── Migration command ── */
  .cmd-note { font-size: 12px; color: var(--muted); line-height: 1.6; }
  .cmd-note code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    color: var(--text-secondary);
  }
  .cmd-intro { margin-bottom: 14px; }
  .cmd-step { margin-bottom: 14px; }
  .cmd-step:last-of-type { margin-bottom: 0; }
  .cmd-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }
  .cmd-tag {
    padding: 1px 8px;
    border-radius: var(--radius-xs);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .cmd-tag.safe { background: var(--ok-dim); color: var(--ok); }
  .cmd-tag.oneway { background: var(--warn-dim); color: var(--warn); }
  .cmd-block {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: var(--code-bg);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }
  .cmd-block:hover { border-color: var(--border); }
  .cmd-text {
    flex: 1;
    min-width: 0;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-secondary);
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  .cmd-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .cmd-copy:hover { background: rgba(255,255,255,0.1); color: var(--text); border-color: rgba(255,255,255,0.2); }
  .cmd-copy.is-ok { background: var(--ok-dim); color: var(--ok); border-color: rgba(16,185,129,0.3); }
  .cmd-copy.is-warn { background: var(--warn-dim); color: var(--warn); border-color: rgba(245,158,11,0.3); }
  .cmd-desc { margin-top: 6px; }
</style>
</head>
<body>

<!-- ══ Header ══ -->
<div class="header">
  <div class="header-inner">
    <div class="header-top">
      <div>
        <h1>Sentinel Table Migration Review</h1>
        <p class="subtitle">Classic custom log table discovery, dependency impact analysis, and Content Hub solution mapping.</p>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
        <button class="about-btn" onclick="document.getElementById('about-modal').classList.add('open');document.body.classList.add('modal-open')">
          <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          About
        </button>
      </div>
    </div>
    <div class="meta-bar" id="meta"></div>
  </div>
</div>

<!-- ══ Main ══ -->
<main>
  <div class="stats" id="stats"></div>

  <!-- Tables section -->
  <div class="section-header">
    <div class="section-icon" style="background: var(--accent-dim); color: var(--accent);">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    </div>
    <h2>Classic Tables</h2>
    <span class="section-count" id="table-count"></span>
  </div>

  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="impacted">With Impact</button>
    <button class="filter-btn" data-filter="indirect">Via Parser</button>
    <button class="filter-btn" data-filter="unmatched">No Solution Match</button>
    <button class="filter-btn" data-filter="noconnector">No Data Connector</button>
    <button class="filter-btn" data-filter="azurefunctions">Azure Functions</button>
  </div>
  <div id="tables"></div>

  <!-- Resolver coverage: where the chained-dependency analysis stops. -->
  <div id="resolver-coverage"></div>

  <!-- Key Concepts -->
  <div class="section-header" style="margin-top: 56px;">
    <div class="section-icon" style="background: var(--purple-dim); color: var(--purple);">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
    </div>
    <h2>Key Concepts</h2>
  </div>

  <div class="about-grid">
    <div class="about-card">
      <h3>
        <svg class="icon" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Classic (V1) Tables
      </h3>
      <p>Custom log tables created via the legacy HTTP Data Collector API. Identified by the _CL suffix and Classic subtype. These are the tables that need migrating.</p>
      <a class="doc-link" href="https://learn.microsoft.com/en-us/azure/azure-monitor/logs/custom-logs-migrate" target="_blank" rel="noopener">Migration guide &#8594;</a>
    </div>
    <div class="about-card">
      <h3>
        <svg class="icon" style="color: var(--ok);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        DCR-Based Tables
      </h3>
      <p>The new table format using Data Collection Rules for ingestion. Supports the Logs Ingestion API, Data Lake mirroring, and clean column schemas.</p>
      <a class="doc-link" href="https://learn.microsoft.com/en-us/azure/azure-monitor/essentials/data-collection-rule-overview" target="_blank" rel="noopener">DCR overview &#8594;</a>
    </div>
    <div class="about-card">
      <h3>
        <svg class="icon" style="color: var(--err);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        API Retirement
      </h3>
      <p>The HTTP Data Collector API retires on <strong style="color:var(--err);">September 14, 2026</strong>. After this date, classic table ingestion stops entirely. All custom log tables must use the Logs Ingestion API via DCRs.</p>
      <a class="doc-link" href="https://learn.microsoft.com/en-us/azure/azure-monitor/logs/custom-logs-migrate#why-migrate" target="_blank" rel="noopener">Retirement details &#8594;</a>
    </div>
    <div class="about-card">
      <h3>
        <svg class="icon" style="color: var(--warn);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Content Hub Solutions
      </h3>
      <p>Pre-built analytics rules, hunting queries, and workbooks from Microsoft and partners. Solutions are matched to your tables to ensure detection coverage after migration.</p>
      <a class="doc-link" href="https://learn.microsoft.com/en-us/azure/sentinel/sentinel-solutions" target="_blank" rel="noopener">Content Hub &#8594;</a>
    </div>
    <div class="about-card">
      <h3>
        <svg class="icon" style="color: var(--cyan);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12l4 6-10 13L2 9z"/></svg>
        Data Lake Compatibility
      </h3>
      <p>Classic tables cannot be mirrored to the Microsoft Sentinel Data Lake tier. Migrating to DCR-based tables unlocks unified long-term storage and cross-workspace queries.</p>
    </div>
    <div class="about-card">
      <h3>
        <svg class="icon" style="color: var(--purple);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
        Schema Consistency
      </h3>
      <p>Classic columns use auto-inferred type suffixes (_s, _d, _b, _g, _t) that break KQL in analytics rules, workbooks, and playbooks. DCR-based tables use clean, predictable column names.</p>
    </div>
  </div>

  <!-- CSAM/SSP callout banner -->
  <div class="callout action-required" style="margin-top: 24px;">
    
    <div class="callout-body">
      <div class="callout-title">No Data Connector Available?</div>
      <div class="callout-text">
        If a modern data connector (CCF, AMA, or Platform) is not available for your table, contact your Microsoft <strong>CSAM / SSP</strong> and raise a <strong>Feature Request</strong> with the Engineering team to prioritise building one. Include the table name and business justification for continued data collection.
      </div>
    </div>
  </div>
</main>

<!-- ══ About Modal ══ -->
<div class="modal-backdrop" id="about-modal" onclick="if(event.target===this){this.classList.remove('open');document.body.classList.remove('modal-open')}">
  <div class="modal">
    <div class="modal-header">
      <h2>
        <svg class="icon-lg" style="color: var(--purple);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        About This Report
      </h2>
      <button class="modal-close" onclick="document.getElementById('about-modal').classList.remove('open');document.body.classList.remove('modal-open')" title="Close">&#10005;</button>
    </div>
    <div class="modal-body">
      <div class="modal-app-info">
        <div>
          <div class="app-name">Table Migration Manager</div>
          <div class="app-desc">Migrate classic custom log tables to DCR-based tables for Microsoft Sentinel Data Lake compatibility.</div>
        </div>
        <div style="display:flex;gap:6px;align-items:center;flex-shrink:0;">
          <span class="version-badge">
            <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            v0.2.1 · PowerShell
          </span>
        </div>
      </div>

      <div class="modal-section-label">Author</div>
      <div class="about-grid" style="grid-template-columns: 1fr;">
    <div class="contributor primary">
      <div class="avatar" style="background: var(--accent-dim); color: var(--accent);">TG</div>
      <div class="contrib-info">
        <div class="contrib-name">Toby G</div>
        <div class="contrib-roles">
          <span class="role-tag developer">Developer</span>
          <span class="role-tag designer">Designer</span>
          <span class="role-tag tester">Tester</span>
        </div>
        <div class="contrib-desc">Designed and implemented the Table Migration Manager for migrating classic custom log tables to DCR-based tables.</div>
      </div>
      <div class="contrib-links">
        <a class="contrib-link" href="https://github.com/noodlemctwoodle" target="_blank" rel="noopener" title="GitHub">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a class="contrib-link" href="https://www.linkedin.com/in/546f627947/" target="_blank" rel="noopener" title="LinkedIn">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
    </div>

      <div style="padding: 20px 28px 24px; margin: 20px 28px 0; border-top: 1px solid var(--border); text-align: center;">
        <span style="color: var(--muted); font-size: 12px;">
          Generated by <strong style="color: var(--text-secondary);">Invoke-TableMigrationReview.ps1</strong> &mdash; data source:
          <a href="https://github.com/Azure/Azure-Sentinel/tree/master/Tools/Solutions%20Analyzer" target="_blank" rel="noopener">Azure-Sentinel Solutions Analyzer</a>
        </span>
      </div>
  </div>
</div>

<script>
const DATA = JSON.parse("{{DATA_JSON}}");

// ── Normalize arrays (PowerShell single-item unwrapping) ──
function ensureArray(v) { return Array.isArray(v) ? v : v == null ? [] : [v]; }
DATA.Impacts = ensureArray(DATA.Impacts);
DATA.Tables = ensureArray(DATA.Tables);
DATA.SolutionMatches = ensureArray(DATA.SolutionMatches);
var IMPACT_TYPE_KEYS = ['AnalyticsRules', 'HuntingQueries', 'Parsers', 'SavedSearches', 'Workbooks', 'Playbooks', 'Dcrs'];
DATA.Impacts.forEach(i => {
  IMPACT_TYPE_KEYS.forEach(function(k) {
    i[k] = ensureArray(i[k]);
    // Indirect dependents reach the table only through a parser function.
    i['Indirect' + k] = ensureArray(i['Indirect' + k]);
  });
  // Parsers this table reaches whose own alias could not be resolved. The
  // content calling them is NOT in the lists above, so the report has to say
  // so - a silent gap here is the failure the chained resolver exists to stop.
  i.UnresolvedBridges = ensureArray(i.UnresolvedBridges);
  i.UnresolvedBridges.forEach(function(b) { b.Dependents = ensureArray(b.Dependents); });
});
// Resolver coverage: which parser aliases were not resolved and why, plus any
// fan-out warnings. These reached the console only until now, which left a
// reader of report.html with no idea where the dependency list stops.
DATA.AliasResolution = DATA.AliasResolution || {};
var RESOLVED_ALIASES = ensureArray(DATA.AliasResolution.resolvedAliases);
var SKIPPED_ALIASES = ensureArray(DATA.AliasResolution.skippedAliases);
SKIPPED_ALIASES.forEach(function(s) { s.Dependents = ensureArray(s.Dependents); });
var ALIAS_WARNINGS = ensureArray(DATA.AliasResolution.warnings);
DATA.SolutionMatches.forEach(m => {
  m.Solutions = ensureArray(m.Solutions);
  m.ConnectorClassification = ensureArray(m.ConnectorClassification);
});

// ── Header ──
const metaItems = [
  { label: 'Workspace', value: DATA.Workspace },
  { label: 'Resource Group', value: DATA.ResourceGroup },
  { label: 'Subscription', value: DATA.Subscription },
  { label: 'Generated', value: DATA.GeneratedAt },
];
document.getElementById('meta').innerHTML = metaItems
  .map(m => '<div class="meta-chip"><span class="meta-label">' + m.label + '</span>' + escapeHtml(m.value) + '</div>')
  .join('');

// ── Stats ──
// A table with 0 direct and 5 indirect dependents is not clean. Count both, or
// the header contradicts the cards and calls it "Ready to migrate immediately".
const impactedCount = DATA.Impacts.filter(i => ((i.TotalImpacted || 0) + (i.TotalIndirect || 0)) > 0).length;
const cleanCount = DATA.Tables.length - impactedCount;
const matchedCount = DATA.SolutionMatches.filter(m => m.MatchCount > 0).length;
const unmatchedCount = DATA.SolutionMatches.length - matchedCount;

document.getElementById('stats').innerHTML =
  '<div class="stat">' +
    '<div class="icon-bg" style="background: var(--accent-dim);"></div>' +
    '<div class="label">Classic Tables</div>' +
    '<div class="value" style="color: var(--text);">' + DATA.TotalTables + '</div>' +
    '<div class="desc">V1 custom log tables discovered</div>' +
  '</div>' +
  '<div class="stat">' +
    '<div class="icon-bg" style="background: var(--err-dim);"></div>' +
    '<div class="label">Impacted</div>' +
    '<div class="value" style="color: var(--err);">' + impactedCount + '</div>' +
    '<div class="desc">Tables with content dependencies</div>' +
  '</div>' +
  '<div class="stat">' +
    '<div class="icon-bg" style="background: var(--ok-dim);"></div>' +
    '<div class="label">Clean</div>' +
    '<div class="value" style="color: var(--ok);">' + cleanCount + '</div>' +
    '<div class="desc">Ready to migrate immediately</div>' +
  '</div>' +
  '<div class="stat">' +
    '<div class="icon-bg" style="background: var(--warn-dim);"></div>' +
    '<div class="label">Total Dependencies</div>' +
    '<div class="value" style="color: var(--warn);">' + ((DATA.TotalImpacted || 0) + (DATA.TotalIndirect || 0)) + '</div>' +
    '<div class="desc">' + (DATA.TotalImpacted || 0) + ' direct, ' + (DATA.TotalIndirect || 0) + ' via parser</div>' +
  '</div>' +
  '<div class="stat">' +
    '<div class="icon-bg" style="background: var(--cyan-dim);"></div>' +
    '<div class="label">Solution Matched</div>' +
    '<div class="value" style="color: var(--cyan);">' + matchedCount + '</div>' +
    '<div class="desc">Mapped to Content Hub solutions</div>' +
  '</div>' +
  '<div class="stat">' +
    '<div class="icon-bg" style="background: ' + (unmatchedCount > 0 ? 'var(--err-dim)' : 'var(--ok-dim)') + '"></div>' +
    '<div class="label">No Match</div>' +
    '<div class="value" style="color: ' + (unmatchedCount > 0 ? 'var(--err)' : 'var(--ok)') + ';">' + unmatchedCount + '</div>' +
    '<div class="desc">' + (unmatchedCount > 0 ? 'Require manual investigation' : 'All tables matched') + '</div>' +
  '</div>';

// ── Table count ──
document.getElementById('table-count').textContent = DATA.Tables.length + ' table' + (DATA.Tables.length === 1 ? '' : 's');

// ── Helpers ──
var impactByName = {};
DATA.Impacts.forEach(function(i) { impactByName[i.TableName] = i; });
var matchByName = {};
DATA.SolutionMatches.forEach(function(m) { matchByName[m.TableName] = m; });

function escapeHtml(s) {
  if (s === null || s === undefined) return '';
  return String(s).replace(/[&<>"']/g, function(c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

function shortId(id) {
  if (!id) return '';
  var parts = id.split('/');
  return parts.slice(-2).join('/');
}

function severityClass(sev) {
  if (!sev) return '';
  var s = sev.toLowerCase();
  if (s === 'high') return 'high';
  if (s === 'medium') return 'medium';
  if (s === 'low') return 'low';
  return 'informational';
}

function dotColor(type) {
  var colors = {
    AnalyticsRules: 'var(--err)',
    HuntingQueries: 'var(--purple)',
    Parsers: 'var(--cyan)',
    SavedSearches: 'var(--accent)',
    Workbooks: 'var(--warn)',
    Playbooks: 'var(--ok)',
    Dcrs: 'var(--text-secondary)'
  };
  return colors[type] || 'var(--muted)';
}

// ── Render items ──
// An indirect item never names the table in its own query, so it carries a
// "via" chip naming the parser it does call. Three signals mark it: the chip,
// a hollow dot, and a cyan left edge on the row.
function renderImpactItem(item, type, tableName) {
  var meta = item.ResourceId ? '<span class="item-meta">' + escapeHtml(shortId(item.ResourceId)) + '</span>' : '';
  var severity = item.Severity ? '<span class="severity ' + severityClass(item.Severity) + '">' + escapeHtml(item.Severity) + '</span>' : '';
  var enabled = item.Enabled === false ? '<span class="badge warn">Disabled</span>' : '';

  var isIndirect = item.DependencyKind === 'Indirect';
  var via = '';
  var dotStyle = 'background: ' + dotColor(type) + ';';

  if (isIndirect) {
    var hops = ensureArray(item.ViaChain);
    if (hops.length === 0 && item.Via) { hops = [item.Via]; }
    var chain = [item.Name].concat(hops);
    if (tableName) { chain = chain.concat([tableName]); }
    via = '<span class="badge via" title="' + escapeHtml('Reaches the table through a parser function: ' + chain.join(' -> ')) + '">' +
          'via ' + hops.map(function(h) { return escapeHtml(h); }).join(' &#8594; ') +
          '</span>';
    dotStyle = 'box-shadow: inset 0 0 0 2px ' + dotColor(type) + ';';
  }

  return '<div class="item' + (isIndirect ? ' indirect' : '') + '">' +
    '<span class="dot' + (isIndirect ? ' indirect' : '') + '" style="' + dotStyle + '"></span>' +
    '<span class="item-name">' + escapeHtml(item.Name) + '</span>' +
    via + severity + enabled + meta +
  '</div>';
}

function renderSolution(s, connectorKind) {
  var installed = s.IsInstalled
    ? '<span class="badge clean">Installed</span>'
    : '<span class="badge warn">Not Installed</span>';
  var hubStatus = s.IsInContentHub ? '' : '<span class="badge info">Not in catalog</span>';
  var github = s.GithubUrl
    ? '<a href="' + escapeHtml(s.GithubUrl) + '" target="_blank" rel="noopener" style="font-size:11px;">View source &#8594;</a>'
    : '';
  var kindBadge = connectorKind && connectorKind !== 'Unknown'
    ? '<span class="badge ' + connectorKind.toLowerCase() + '">' + escapeHtml(connectorKind) + '</span>'
    : '';
  var icon = s.IsInstalled ? '&#10003;' : '';
  var iconBg = s.IsInstalled ? 'background:var(--ok-dim);color:var(--ok);' : 'background:var(--warn-dim);color:var(--warn);';

  return '<div class="solution-item">' +
    '<div class="sol-icon" style="' + iconBg + '">' + icon + '</div>' +
    '<div class="sol-details">' +
      '<div class="sol-name">' + escapeHtml(s.DisplayName || s.SolutionName) + '</div>' +
      '<div class="sol-sub">' + (s.IsInContentHub ? 'Available in Content Hub' : 'Not found in workspace catalog') + '</div>' +
    '</div>' +
    '<div class="sol-actions">' + kindBadge + installed + hubStatus + github + '</div>' +
  '</div>';
}

// ── Render connector callout ──
function renderConnectorCallout(match) {
  var classifications = match.ConnectorClassification || [];
  var hasUnknown = classifications.some(function(c) { return c.ConnectorKind === 'Unknown'; });
  var hasAzureFunc = classifications.some(function(c) { return c.ConnectorKind === 'AzureFunctions'; });
  var hasCCF = classifications.some(function(c) { return c.ConnectorKind === 'CCF'; });
  var hasPlatform = classifications.some(function(c) { return c.ConnectorKind === 'Platform'; });
  var hasAMA = classifications.some(function(c) { return c.ConnectorKind === 'AMA'; });

  if (match.MatchCount === 0) {
    return '<div class="callout action-required">' +
      '' +
      '<div class="callout-body">' +
        '<div class="callout-title">No Content Hub Solution Available</div>' +
        '<div class="callout-text">' +
          'No Content Hub solution matches this table. No data connector is available to ingest data into a DCR-based replacement.<br><br>' +
          '<strong>Action required:</strong> Contact your Microsoft CSAM / SSP and raise a <strong>Feature Request</strong> with the Engineering team to prioritise building a connector for this data source. Include the table name and your business justification for continued data collection.' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  if (hasUnknown && !hasCCF && !hasPlatform && !hasAMA) {
    return '<div class="callout attention">' +
      '' +
      '<div class="callout-body">' +
        '<div class="callout-title">Data Connector Not Identified</div>' +
        '<div class="callout-text">' +
          'A Content Hub solution exists for this table, but no compatible data connector (CCF, AMA, or Platform) was detected in the solution package.<br><br>' +
          '<strong>Action required:</strong> Check the Content Hub solution for connector availability. If no modern connector exists, contact your Microsoft CSAM / SSP and raise a <strong>Feature Request</strong> with Engineering to build a Codeless Connector Framework (CCF) connector for this data source.' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  if (hasAzureFunc && !hasCCF) {
    return '<div class="callout attention">' +
      '' +
      '<div class="callout-body">' +
        '<div class="callout-title">Legacy Azure Functions Connector</div>' +
        '<div class="callout-text">' +
          'This table is served by a legacy Azure Functions-based connector. These connectors require customer-managed infrastructure, incur additional compute costs, and do not benefit from the Codeless Connector Framework (CCF).<br><br>' +
          '<strong>Action required:</strong> Check Content Hub for a CCF equivalent. If none exists yet, contact your Microsoft CSAM / SSP and raise a <strong>Feature Request</strong> with Engineering to prioritise CCF parity for this data source.' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  if (hasCCF || hasPlatform || hasAMA) {
    var connType = hasPlatform ? 'Platform-native' : hasCCF ? 'Codeless Connector Framework (CCF)' : 'Azure Monitor Agent (AMA)';
    return '<div class="callout success">' +
      '<div class="callout-body">' +
        '<div class="callout-title">Modern Connector Available</div>' +
        '<div class="callout-text">' +
          'This table has a <strong>' + connType + '</strong> connector available. You can migrate to a DCR-based table and use the modern connector for continued data ingestion.' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  return '';
}

// ── Migration command ──
// This report is a static artefact. It never runs anything and never talks to
// Azure; it only shows the exact command an operator can paste into their own
// shell, so the assess step hands over to the migrate step without anyone
// retyping resource names.

// Invoke-ClassicTableMigration.ps1 puts [ValidatePattern('^[A-Za-z0-9_]+$')]
// on -TableName, and only migrates names ending in _CL. Anything else cannot
// be expressed as a valid command, so no command is offered for it.
var CMD_TABLE_NAME = /^[A-Za-z0-9_]+$/;
var CMD_GUID = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;

// PowerShell closes a single-quoted string on any of FIVE characters, not just
// the ASCII apostrophe: U+0027 and the curved quotes U+2018, U+2019, U+201A and
// U+201B are interchangeable as both delimiter and escape. Escaping only U+0027
// would leave a resource group named with a curved quote able to close the
// string early and append further statements to the copied command, and Azure
// resource group names do permit Unicode. Doubling any of the five yields that
// literal character, so doubling all five is the complete encoding.
var CMD_PS_QUOTES = /['\u2018\u2019\u201a\u201b]/g;

function psQuote(value) {
  // Inside a single-quoted string PowerShell performs no variable
  // interpolation, no subexpression evaluation and no backtick escapes, so the
  // closing quote is the only character with meaning. Double every one of them.
  if (value === null || value === undefined) return "''";
  return "'" + String(value).replace(CMD_PS_QUOTES, function (m) { return m + m; }) + "'";
}

function migrationCommands(t) {
  var name = (t && t.Name !== null && t.Name !== undefined) ? String(t.Name) : '';
  if (!name || !CMD_TABLE_NAME.test(name) || name.slice(-3) !== '_CL') return null;
  if (!DATA.ResourceGroup || !DATA.Workspace) return null;

  var base = './Invoke-ClassicTableMigration.ps1' +
    ' -ResourceGroupName ' + psQuote(DATA.ResourceGroup) +
    ' -WorkspaceName ' + psQuote(DATA.Workspace) +
    ' -TableName ' + psQuote(name);

  // Pin the subscription only when the captured value really is a GUID.
  // Anything else would bind and then fail at Set-AzContext after the paste.
  var sub = DATA.Subscription ? String(DATA.Subscription).replace(/^\s+|\s+$/g, '') : '';
  if (sub && CMD_GUID.test(sub)) {
    base += ' -SubscriptionId ' + psQuote(sub);
  }

  return [
    {
      label: 'Preview',
      tag: 'Read-only',
      tagClass: 'safe',
      cmd: base + ' -ListOnly',
      desc: 'Lists the table, its size and its current sub type. Changes nothing. Run it again after migrating to confirm the sub type flipped to DataCollectionRuleBased.'
    },
    {
      label: 'Migrate and deploy',
      tag: 'One-way',
      tagClass: 'oneway',
      cmd: base + ' -Deploy',
      desc: 'Converts the table to DCR-based, then deploys the generated data collection rule. Prompts for confirmation before it commits.'
    }
  ];
}

function renderMigrationSection(t) {
  var heading = '<h3>Migration Command</h3>';
  var cmds = migrationCommands(t);

  if (!cmds) {
    // Two distinct causes, so say which one applies rather than blaming the
    // table name for a workspace the report failed to capture.
    var why;
    if (!DATA.ResourceGroup || !DATA.Workspace) {
      why = 'This report did not capture a resource group and workspace, so the command cannot be filled in. Supply them yourself when you run ' +
            '<code>Invoke-ClassicTableMigration.ps1</code>.';
    } else {
      why = '<code>Invoke-ClassicTableMigration.ps1</code> accepts only table names made of letters, digits and underscores, and migrates only names ending in <code>_CL</code>. Handle ' +
            '<code>' + escapeHtml(t.Name) + '</code> manually.';
    }
    return '<div class="detail-section">' + heading +
      '<div class="cmd-note">No command is offered for this table. ' + why + '</div>' +
    '</div>';
  }

  var steps = cmds.map(function(c) {
    return '<div class="cmd-step">' +
      '<div class="cmd-label">' + escapeHtml(c.label) +
        '<span class="cmd-tag ' + c.tagClass + '">' + escapeHtml(c.tag) + '</span>' +
      '</div>' +
      '<div class="cmd-block">' +
        '<code class="cmd-text">' + escapeHtml(c.cmd) + '</code>' +
        '<button type="button" class="cmd-copy">Copy</button>' +
      '</div>' +
      '<div class="cmd-note cmd-desc">' + escapeHtml(c.desc) + '</div>' +
    '</div>';
  }).join('');

  return '<div class="detail-section">' + heading +
    '<div class="cmd-note cmd-intro">Run from <code>Tools/ClassicToDcr</code> in a signed-in PowerShell 7 session. Nothing on this page executes; the commands are here to copy.</div>' +
    steps +
    '<div class="callout attention" style="margin-top:16px;">' +
      '' +
      '<div class="callout-body">' +
        '<div class="callout-title">Migration is one-way</div>' +
        '<div class="callout-text">' +
          'A DCR-based table cannot be converted back to a classic table. Work through the dependencies listed above first, and rehearse in a non-production workspace. ' +
          'The migrate command asks for confirmation before it commits, and passing <code>-SubscriptionId</code> changes the subscription on the Az context of the session you run it in.' +
        '</div>' +
      '</div>' +
    '</div>' +
  '</div>';
}

// ── Render table card ──
function renderTable(t) {
  var impact = impactByName[t.Name];
  if (!impact) {
    impact = { TotalImpacted: 0, TotalIndirect: 0, TotalAffected: 0, ChainTruncated: false };
    IMPACT_TYPE_KEYS.forEach(function(k) { impact[k] = []; impact['Indirect' + k] = []; });
  }
  var match = matchByName[t.Name] || { MatchCount: 0, Solutions: [], ConnectorClassification: [] };

  var sections = [];

  var impactTypes = [
    { key: 'AnalyticsRules', label: 'Analytics Rules' },
    { key: 'HuntingQueries', label: 'Hunting Queries' },
    { key: 'Parsers', label: 'Parsers' },
    { key: 'SavedSearches', label: 'Saved Searches' },
    { key: 'Workbooks', label: 'Workbooks' },
    { key: 'Playbooks', label: 'Playbooks' },
    { key: 'Dcrs', label: 'Data Collection Rules' }
  ];

  // Indirect items sit inside the content type they belong to, not in a section
  // of their own. The number beside "Analytics Rules" has to be the number of
  // analytics rules that break, or the heading lies by omission.
  var indirectTotal = 0;

  impactTypes.forEach(function(it) {
    var directItems = ensureArray(impact[it.key]);
    var indirectItems = ensureArray(impact['Indirect' + it.key]);
    if (directItems.length === 0 && indirectItems.length === 0) return;
    indirectTotal += indirectItems.length;
    var items = directItems.concat(indirectItems);
    var split = indirectItems.length
      ? ' <span class="count-split">' + directItems.length + ' direct &#183; ' + indirectItems.length + ' via parser</span>'
      : '';
    sections.push(
      '<div class="detail-section">' +
        '<h3>' + it.label + ' <span class="count">' + items.length + '</span>' + split + '</h3>' +
        '<div class="item-list">' + items.map(function(item) { return renderImpactItem(item, it.key, t.Name); }).join('') + '</div>' +
      '</div>');
  });

  if (indirectTotal > 0) {
    var truncNote = impact.ChainTruncated
      ? ' Some chains are deeper than the resolver walks, so this may still understate the blast radius.'
      : '';
    sections.unshift('<div class="detail-section">' +
      '<div class="callout info">' +
        '<div class="callout-body">' +
          '<div class="callout-title">' + indirectTotal + ' dependenc' + (indirectTotal === 1 ? 'y reaches' : 'ies reach') + ' this table through a parser</div>' +
          '<div class="callout-text">' +
            'These never mention <code>' + escapeHtml(t.Name) + '</code> in their own query. ' +
            'They call a parser function that reads it, so searching the workspace for the table name will not find them. ' +
            'Migrating the table breaks them exactly as if they named it directly.' + truncNote +
          '</div>' +
        '</div>' +
      '</div>' +
    '</div>');
  }

  // An unresolved bridge is a KNOWN gap in the list above, so it goes first:
  // reading a dependency list without knowing where it stops is worse than
  // reading no list at all. This block is unshifted AFTER the indirect
  // callout on purpose, because the last unshift takes the front slot.
  var bridges = ensureArray(impact.UnresolvedBridges);
  if (bridges.length > 0) {
    sections.unshift('<div class="detail-section">' +
      '<div class="callout attention">' +
        '' +
        '<div class="callout-body">' +
          '<div class="callout-title">' + bridges.length + ' parser chain' + (bridges.length === 1 ? '' : 's') + ' could not be followed</div>' +
          '<div class="callout-text">' +
            'These parsers read <code>' + escapeHtml(t.Name) + '</code>, but their function alias could not be resolved by name, ' +
            'so anything calling them is <strong>not listed above</strong>. Check each one by hand before migrating.' +
            '<ul class="bridge-list">' +
            bridges.map(function(b) {
              var deps = ensureArray(b.Dependents);
              var route = ensureArray(b.ViaChain);
              var routeText = route.length
                ? ' reached via ' + route.map(function(h) { return escapeHtml(h); }).join(' &#8594; ') + ','
                : '';
              var depList = deps.length
                ? '<ul>' + deps.map(function(d) {
                    return '<li><span class="bridge-type">' + escapeHtml(d.Type) + '</span> ' + escapeHtml(d.Name) + '</li>';
                  }).join('') + '</ul>'
                : '<div class="bridge-none">Nothing else in the workspace names that alias.</div>';
              var n = b.ReferenceCount || 0;
              return '<li><code>' + escapeHtml(b.Alias) + '</code>' + routeText +
                     ' ' + escapeHtml(b.Reason) + '. ' +
                     '<strong>' + n + '</strong> item' + (n === 1 ? ' names' : 's name') +
                     ' that alias and ' + (n === 1 ? 'was' : 'were') + ' not resolved:' + depList + '</li>';
            }).join('') +
            '</ul>' +
          '</div>' +
        '</div>' +
      '</div>' +
    '</div>');
  }


  // Solutions
  if (match.Solutions && match.Solutions.length > 0) {
    var connMap = {};
    (match.ConnectorClassification || []).forEach(function(c) { connMap[c.SolutionName] = c.ConnectorKind; });
    sections.push(
      '<div class="detail-section">' +
        '<h3>Content Hub Solutions <span class="count">' + match.Solutions.length + '</span></h3>' +
        '<div class="item-list">' + match.Solutions.map(function(s) { return renderSolution(s, connMap[s.SolutionName]); }).join('') + '</div>' +
      '</div>');
  }

  // Connector availability callout
  var callout = renderConnectorCallout(match);
  if (callout) {
    sections.push('<div class="detail-section">' + callout + '</div>');
  }

  // Migration command. Deliberately sits after the connector callout: the
  // reader should see whether a replacement connector exists before they see
  // the command that removes the classic table.
  var migration = renderMigrationSection(t);
  if (migration) {
    sections.push(migration);
  }

  // Table metadata
  sections.push(
    '<div class="detail-section" style="background: rgba(255,255,255,0.015);">' +
      '<h3>Table Properties</h3>' +
      '<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px;">' +
        '<div><span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);font-weight:600;">Plan</span><div style="font-size:13px;font-weight:600;margin-top:2px;">' + escapeHtml(t.Plan) + '</div></div>' +
        '<div><span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);font-weight:600;">Retention</span><div style="font-size:13px;font-weight:600;margin-top:2px;">' + t.RetentionInDays + ' days</div></div>' +
        '<div><span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);font-weight:600;">Columns</span><div style="font-size:13px;font-weight:600;margin-top:2px;">' + t.ColumnCount + '</div></div>' +
        '<div><span style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);font-weight:600;">Sub Type</span><div style="font-size:13px;font-weight:600;margin-top:2px;">' + escapeHtml(t.TableSubType) + '</div></div>' +
      '</div>' +
    '</div>');

  // Badges. The headline count covers direct AND via-parser dependents: a table
  // with only chained dependents must never read "No dependencies".
  var badges = [];
  var directCount = impact.TotalImpacted || 0;
  var indirectCount = impact.TotalIndirect || 0;
  var affectedCount = directCount + indirectCount;

  if (affectedCount > 0) {
    badges.push('<span class="badge impacted">' + affectedCount + ' dependenc' + (affectedCount === 1 ? 'y' : 'ies') + '</span>');
    if (indirectCount > 0) {
      badges.push('<span class="badge via" title="Reached through a parser function, not by table name">' + indirectCount + ' via parser</span>');
    }
  } else {
    badges.push('<span class="badge clean">No dependencies</span>');
  }
  if (match.MatchCount > 0) {
    badges.push('<span class="badge info">' + match.MatchCount + ' solution' + (match.MatchCount === 1 ? '' : 's') + '</span>');
  } else {
    badges.push('<span class="badge warn">No match</span>');
  }

  var classifications = match.ConnectorClassification || [];
  var hasModernConnector = classifications.some(function(c) { return ['CCF', 'Platform', 'AMA'].indexOf(c.ConnectorKind) !== -1; });
  var hasAzureFunc = classifications.some(function(c) { return c.ConnectorKind === 'AzureFunctions'; });
  var allUnknown = classifications.length > 0 && classifications.every(function(c) { return c.ConnectorKind === 'Unknown'; });

  if (hasModernConnector) {
    var kind = classifications.filter(function(c) { return ['CCF', 'Platform', 'AMA'].indexOf(c.ConnectorKind) !== -1; })[0].ConnectorKind;
    badges.push('<span class="badge platform">' + kind + '</span>');
  } else if (hasAzureFunc) {
    badges.push('<span class="badge warn">Azure Functions</span>');
  } else if (match.MatchCount === 0) {
    badges.push('<span class="badge impacted">No connector</span>');
  } else if (allUnknown) {
    badges.push('<span class="badge purple">Connector unknown</span>');
  }

  var azureFuncCount = classifications.filter(function(c) { return c.ConnectorKind === 'AzureFunctions'; }).length;
  var noConnector = (match.MatchCount === 0 || allUnknown) ? 1 : 0;

  return '<details class="table-card" data-impact="' + affectedCount + '" data-indirect="' + indirectCount + '" data-match="' + match.MatchCount + '" data-azurefunc="' + azureFuncCount + '" data-noconnector="' + noConnector + '">' +
      '<summary>' +
        '<span class="chevron">&#9656;</span>' +
        '<span class="table-name">' + escapeHtml(t.Name) + '</span>' +
        '<div class="badge-row">' + badges.join('') + '</div>' +
      '</summary>' +
      '<div class="detail-body">' +
        sections.join('') +
      '</div>' +
    '</details>';
}

document.getElementById('tables').innerHTML = DATA.Tables.map(renderTable).join('');

// ── Render resolver coverage ──
// The chained-dependency lists above are only as complete as the parser-alias
// resolver, and the resolver deliberately refuses to follow some aliases. That
// refusal used to be a console line nobody kept. Stating it here, in the file
// that actually gets shared, is the difference between "there are no more
// dependencies" and "the tool stopped looking, here is exactly where".

function renderResolverCoverage() {
  var host = document.getElementById('resolver-coverage');
  if (!host) { return; }
  if (SKIPPED_ALIASES.length === 0 && ALIAS_WARNINGS.length === 0) { host.innerHTML = ''; return; }

  var blocks = [];

  if (SKIPPED_ALIASES.length > 0) {
    blocks.push(
      '<div class="callout attention">' +
        '' +
        '<div class="callout-body">' +
          '<div class="callout-title">' + SKIPPED_ALIASES.length + ' parser alias' +
            (SKIPPED_ALIASES.length === 1 ? ' was' : 'es were') + ' not followed</div>' +
          '<div class="callout-text">' +
            'Chained dependencies are found by treating a parser function alias as if it were a table name. ' +
            'An alias that is a KQL keyword, or that collides with a real table in this workspace, would match ' +
            'unrelated queries, so it is left out. Anything calling these parsers is <strong>not</strong> in the ' +
            'lists above and needs checking by hand.' +
            '<ul class="bridge-list">' +
            SKIPPED_ALIASES.map(function(s) {
              var deps = ensureArray(s.Dependents);
              var depList = deps.length
                ? '<ul>' + deps.map(function(d) {
                    return '<li><span class="bridge-type">' + escapeHtml(d.Type) + '</span> ' + escapeHtml(d.Name) + '</li>';
                  }).join('') + '</ul>'
                : '<div class="bridge-none">Nothing else in the workspace names that alias.</div>';
              var n = s.ReferenceCount || 0;
              return '<li><code>' + escapeHtml(s.Alias) + '</code> (parser <em>' + escapeHtml(s.Parser) + '</em>) - ' +
                     escapeHtml(s.Reason) + '. <strong>' + n + '</strong> item' + (n === 1 ? ' names' : 's name') +
                     ' that alias and ' + (n === 1 ? 'was' : 'were') + ' not resolved:' + depList + '</li>';
            }).join('') +
            '</ul>' +
          '</div>' +
        '</div>' +
      '</div>');
  }

  if (ALIAS_WARNINGS.length > 0) {
    blocks.push(
      '<div class="callout attention">' +
        '' +
        '<div class="callout-body">' +
          '<div class="callout-title">' + ALIAS_WARNINGS.length + ' alias' +
            (ALIAS_WARNINGS.length === 1 ? '' : 'es') + ' referenced by an implausible share of the workspace</div>' +
          '<div class="callout-text">' +
            'These chains are still reported in full (suppressing them would hide a real dependency), but an ' +
            'alias named by most of the workspace is more likely a name collision than a genuine shared parser.' +
            '<ul class="bridge-list">' +
            ALIAS_WARNINGS.map(function(w) { return '<li>' + escapeHtml(w) + '</li>'; }).join('') +
            '</ul>' +
          '</div>' +
        '</div>' +
      '</div>');
  }

  host.innerHTML =
    '<div class="section-header" style="margin-top: 56px;">' +
      '<div class="section-icon" style="background: var(--warn-dim); color: var(--warn);">' +
        '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
        '<circle cx="12" cy="12" r="10"/><path d="M12 8v5"/><path d="M12 16h.01"/></svg>' +
      '</div>' +
      '<h2>Resolver Coverage</h2>' +
      '<span class="section-count">' + RESOLVED_ALIASES.length + ' alias' +
        (RESOLVED_ALIASES.length === 1 ? '' : 'es') + ' followed</span>' +
    '</div>' +
    blocks.join('');
}

renderResolverCoverage();

// ── Copy to clipboard ──
// This report is normally opened from disk. Every current engine treats the
// "file" scheme as a potentially trustworthy origin, so navigator.clipboard is
// present here. The fallbacks still matter: the async API rejects when the
// document is not focused, and the report may also be served over plain http
// from a file share. All three paths are local; nothing here touches a network.

function legacyCopy(text) {
  var ta = document.createElement('textarea');
  ta.value = text;
  // readonly suppresses the mobile keyboard; contentEditable keeps iOS Safari
  // willing to select the contents.
  ta.setAttribute('readonly', '');
  ta.contentEditable = 'true';
  // A 16px font stops iOS zooming on focus. opacity:0 rather than
  // display:none, because a non-rendered textarea cannot be selected.
  ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;' +
    'padding:0;border:none;outline:none;box-shadow:none;' +
    'background:transparent;opacity:0;font-size:16px';
  document.body.appendChild(ta);

  var ok = false;
  try {
    // Range selection is what iOS Safari honours; select() alone is ignored.
    var range = document.createRange();
    range.selectNodeContents(ta);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    ta.setSelectionRange(0, text.length);
    ta.readOnly = true;
    ta.focus();
    ok = document.execCommand('copy');
  } catch (e) {
    ok = false;
  }
  document.body.removeChild(ta);
  return ok;
}

function selectForManualCopy(el) {
  if (!el) return false;
  try {
    var range = document.createRange();
    range.selectNodeContents(el);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    return true;
  } catch (e) {
    return false;
  }
}

function flashCopyState(btn, label, cls) {
  if (!btn) return;
  if (!btn.getAttribute('data-label')) {
    btn.setAttribute('data-label', btn.textContent);
  }
  btn.textContent = label;
  btn.classList.remove('is-ok', 'is-warn');
  if (cls) btn.classList.add(cls);
  // Per-button timer, so copying from two cards in quick succession does not
  // leave one of them stuck on its feedback label.
  if (btn.resetTimer) clearTimeout(btn.resetTimer);
  btn.resetTimer = setTimeout(function() {
    btn.textContent = btn.getAttribute('data-label') || 'Copy';
    btn.classList.remove('is-ok', 'is-warn');
  }, 2400);
}

function copyText(text, btn, codeEl) {
  function settle(ok) {
    if (ok) {
      flashCopyState(btn, 'Copied', 'is-ok');
    } else if (selectForManualCopy(codeEl)) {
      flashCopyState(btn, 'Press Ctrl+C', 'is-warn');
    } else {
      flashCopyState(btn, 'Copy failed', 'is-warn');
    }
  }

  // Branch 1: the async Clipboard API, called synchronously inside the click
  // handler so the user activation is not treated as spent.
  if (navigator.clipboard && navigator.clipboard.writeText) {
    var p = null;
    try {
      p = navigator.clipboard.writeText(text);
    } catch (e) {
      p = null;
    }
    if (p && typeof p.then === 'function') {
      p.then(
        function() { settle(true); },
        // Branch 2: transient activation outlives the promise turn, so the
        // synchronous fallback is still valid from the rejection handler.
        function() { settle(legacyCopy(text)); }
      );
      return;
    }
  }

  settle(legacyCopy(text));
}

// One delegated listener rather than one per button: the cards are built with
// innerHTML, and an inline onclick carrying an interpolated table name would
// be unescapable in the general case.
document.getElementById('tables').addEventListener('click', function(ev) {
  var btn = (ev.target && ev.target.closest) ? ev.target.closest('.cmd-copy') : null;
  if (!btn) return;
  ev.preventDefault();
  ev.stopPropagation();
  var block = btn.closest('.cmd-block');
  var codeEl = block ? block.querySelector('.cmd-text') : null;
  if (!codeEl) return;
  copyText(codeEl.textContent, btn, codeEl);
});

// ── Filters ──
document.querySelectorAll('.filter-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var f = btn.dataset.filter;
    var visible = 0;
    document.querySelectorAll('.table-card').forEach(function(el) {
      var impact = Number(el.dataset.impact);
      var ind = Number(el.dataset.indirect);
      var match = Number(el.dataset.match);
      var af = Number(el.dataset.azurefunc);
      var nc = Number(el.dataset.noconnector);
      var show = true;
      if (f === 'impacted') show = impact > 0;
      else if (f === 'indirect') show = ind > 0;
      else if (f === 'unmatched') show = match === 0;
      else if (f === 'azurefunctions') show = af > 0;
      else if (f === 'noconnector') show = nc > 0;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    document.getElementById('table-count').textContent = visible + ' of ' + DATA.Tables.length + ' table' + (DATA.Tables.length === 1 ? '' : 's');
  });
});
</script>
</body>
</html>
