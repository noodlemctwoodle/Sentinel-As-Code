# Service principal used by Test-DcrIngestion.ps1 to stream into the DCR's
# Logs Ingestion endpoint. Copy this file to `.env` (which is gitignored)
# and fill in the values. The .env is loaded automatically when you run
# Test-DcrIngestion.ps1 from this folder.
#
# The service principal needs only one Azure role:
#   Monitoring Metrics Publisher, scoped to the target DCR.

DCR_INGEST_TENANT_ID=
DCR_INGEST_CLIENT_ID=
DCR_INGEST_CLIENT_SECRET=
