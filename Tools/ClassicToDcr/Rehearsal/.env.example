# Service principal used by Test-DcrIngestion.ps1 (in this Rehearsal folder) to
# stream into the DCR's Logs Ingestion endpoint. Copy this file to `.env` here,
# next to the tester (the real `.env` is gitignored), and fill in the values.
# The tester loads a `.env` sitting beside it automatically, so it works whether
# you run it from here or from the ClassicToDcr folder as ./Rehearsal/... .
#
# The service principal needs only one Azure role:
#   Monitoring Metrics Publisher, scoped to the target DCR.

DCR_INGEST_TENANT_ID=
DCR_INGEST_CLIENT_ID=
DCR_INGEST_CLIENT_SECRET=
