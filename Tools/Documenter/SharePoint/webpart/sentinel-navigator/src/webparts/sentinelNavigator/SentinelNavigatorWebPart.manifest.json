{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "a2fd5aa3-01c5-431e-8c98-66f76c89803a",
  "alias": "SentinelNavigatorWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // The web part renders a dashboard file from this site's own Documenter
  // Assets library; it does not let page authors embed their own script, so
  // it does not need custom script enabled on the site.
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart"],
  "supportsThemeVariants": true,
  // Allowed in full-width sections on communication sites; the publisher
  // places it in one so the dashboard uses the whole page width.
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Sentinel workspace dashboard" },
    "description": { "default": "Interactive Microsoft Sentinel workspace dashboard generated by the Sentinel Documenter" },
    "officeFabricIconFontName": "Shield",
    "properties": {
      "fileRelativeUrl": "DocumenterAssets/dashboard/index.html"
    }
  }]
}
