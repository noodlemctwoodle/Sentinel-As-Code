# SparkNotebooks - local config (COMMITTED TEMPLATE)
#
# Copy this file to ".env" in the same folder and set your real values.
# ".env" is git-ignored by the repo root .gitignore (the ".env" / ".env.*"
# rules), so your workspace name is never committed. This matches the repo's
# existing .env / .env.example convention (see Rehearsal/Test-DcrIngestion.ps1).
#
# NOTE: the Spark kernel runs in the cloud and cannot read this file at run
# time. Values are stamped into the notebooks locally by apply_config.py:
#     python3 apply_config.py apply     # inject before you run the notebooks
#     python3 apply_config.py reset     # restore placeholders before you commit
#     python3 apply_config.py check     # fail if a real workspace name is present

# The Log Analytics workspace onboarded to the Sentinel data lake.
# Get the exact name by running, in any notebook:  data_provider.list_databases()
SENTINEL_WORKSPACE_NAME=your-workspace-name
